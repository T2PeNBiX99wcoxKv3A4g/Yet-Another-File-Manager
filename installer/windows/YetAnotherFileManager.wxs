<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-user installer: Yet Another File Manager keeps its settings, its caches and its per-folder
    indexes under %APPDATA% and %LOCALAPPDATA%, so it never needs elevation and never writes to a
    location another user shares.

    The published build is a single executable plus the Rust helper that speeds up gallery scans.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Yet Another File Manager"
             Manufacturer="yukiyosanako"
             Version="$(var.Version)"
             UpgradeCode="0f5d3f9b-6a1e-4b0e-9f3a-2c7d5e8b1a44"
             Scope="perUser"
             Compressed="yes"
             InstallerVersion="500">

        <SummaryInformation Description="Yet Another File Manager file manager" Manufacturer="yukiyosanako" />

        <!--
            Force the per-user context even when the MSI is started from an elevated shell: the app
            lives in %LOCALAPPDATA% and keeps its settings under %APPDATA%, so a per-machine copy
            would be shared by every user and none of them could use it properly.
        -->
        <Property Id="ALLUSERS" Value="2" />
        <Property Id="MSIINSTALLPERUSER" Value="1" />

        <!-- A reinstall of the same version replaces the files instead of failing. -->
        <MajorUpgrade AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="A newer version of Yet Another File Manager is already installed." />

        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

        <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
        <Property Id="ARPHELPLINK" Value="https://github.com/T2PeNBiX99wcoxKv3A4g/Yet-Another-File-Manager" />
        <Property Id="ARPNOMODIFY" Value="1" />

        <Feature Id="Main" Title="Yet Another File Manager" Level="1">
            <ComponentGroupRef Id="ApplicationFiles" />
        </Feature>
    </Package>

    <Fragment>
        <!-- Same place per-user installers normally use, so no elevation is involved. -->
        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="ProgramsFolder" Name="Programs">
                <Directory Id="INSTALLFOLDER" Name="Yet Another File Manager" />
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder" />

        <StandardDirectory Id="DesktopFolder" />
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ApplicationFiles">
            <Component Id="Application" Directory="INSTALLFOLDER" Guid="*">
                <File Id="YetAnotherFileManagerExe" Source="$(var.SourceDir)\YetAnotherFileManager.exe" KeyPath="yes">
                    <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Yet Another File Manager"
                              Description="Browse files with previews, a gallery and a recycle bin" />
                    <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Yet Another File Manager"
                              Description="Browse files with previews, a gallery and a recycle bin" />
                </File>
                <!-- "yafm <path>" from any prompt after the install folder is added to the user PATH. -->
                <File Id="YafmCommand" Source="$(var.SourceDir)\yafm.cmd" />
                <Environment Id="UserPath" Name="PATH" Action="set" Part="last" System="no"
                             Value="[INSTALLFOLDER]" />
                <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            </Component>
            <Component Id="NativeHelper" Directory="INSTALLFOLDER" Guid="*">
                <File Id="YafmNativeDll" Source="$(var.SourceDir)\yafm_native.dll" KeyPath="yes" />
            </Component>
            <!-- One file per component: an automatically generated guid is only valid for a
                 component whose keypath carries a version, and these Rust binaries carry none. -->
            <Component Id="ShellMenuHelper" Directory="INSTALLFOLDER" Guid="*">
                <File Id="YafmShellMenuExe" Source="$(var.SourceDir)\yafm-shellmenu.exe" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
