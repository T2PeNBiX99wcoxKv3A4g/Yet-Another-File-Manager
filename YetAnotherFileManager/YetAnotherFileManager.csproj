<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generator -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RootNamespace>YetAnotherFileManager</RootNamespace>
        <Version>0.4.3</Version>
        <!-- Explorer/taskbar icon; also embedded (Resources\**) so the tray can load it at runtime. -->
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Suppress trim warnings from third-party libraries -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The gallery decodes and re-encodes pictures in this process. Garbage that the runtime
             would normally leave lying around is a lot of memory for a file manager, so the GC is
             told to be eager about giving it back instead of waiting for the next collection. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <!-- PhotinoNETUtils creates the startup shortcut with this library. -->
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
        <PackageReference Include="Docnet.Core" Version="2.6.0" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SevenZipExtractor" Version="1.0.19" />
        <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
        <PackageReference Include="SharpCompress" Version="0.50.8" />
        <!-- Enumerates the installed font families for the settings page (Windows only). -->
        <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="PhotinoNETUtils">
            <HintPath>Libs\PhotinoNETUtils.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- The "yafm" command: a batch shim beside the executable, copied to the publish folder
             too so the MSI and the plain archive both carry it. -->
        <None Include="..\installer\windows\yafm.cmd" Link="yafm.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- 7z.dll is redistributed under the LGPL, so its license ships beside it. -->
        <None Include="Native\licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Rust handles bulk filesystem work: the gallery scan, ZIP creation, measuring and deleting
         trees. The library is required, so the build stops when cargo is missing or the crate does
         not compile, and the file is copied beside the executable. -->
    <PropertyGroup>
        <RustManifest>$(MSBuildProjectDirectory)/Native/yafm-native/Cargo.toml</RustManifest>
        <RustReleaseDir>$(MSBuildProjectDirectory)/Native/yafm-native/target/release</RustReleaseDir>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">yafm_native.dll</RustLibraryName>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libyafm_native.so</RustLibraryName>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libyafm_native.dylib</RustLibraryName>

        <!-- The cargo rustup keeps in CARGO_HOME is the one that follows toolchain updates, so it
             is preferred over whatever the launching process happens to have on its PATH. An IDE
             started before rustup was installed has neither, and can set CargoCommand by hand
             (dotnet build -p:CargoCommand=...). -->
        <CargoCommand Condition="'$(CargoCommand)' == '' and '$(CARGO_HOME)' != '' and Exists('$(CARGO_HOME)\bin\cargo.exe')">$(CARGO_HOME)\bin\cargo.exe</CargoCommand>
        <CargoCommand Condition="'$(CargoCommand)' == '' and '$(CARGO_HOME)' != '' and Exists('$(CARGO_HOME)/bin/cargo')">$(CARGO_HOME)/bin/cargo</CargoCommand>
        <CargoCommand Condition="'$(CargoCommand)' == ''">cargo</CargoCommand>
    </PropertyGroup>

    <Target Name="BuildRustNative" BeforeTargets="Build" Condition="Exists('$(RustManifest)')">
        <Exec Command="&quot;$(CargoCommand)&quot; build --release --manifest-path &quot;$(RustManifest)&quot;" />
    </Target>

    <Target Name="CopyRustNative" AfterTargets="Build" Condition="Exists('$(RustReleaseDir)/$(RustLibraryName)')">
        <Copy SourceFiles="$(RustReleaseDir)/$(RustLibraryName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustShellMenu" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and Exists('$(RustReleaseDir)/yafm-shellmenu.exe')">
        <Copy SourceFiles="$(RustReleaseDir)/yafm-shellmenu.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustNativeOnPublish" AfterTargets="Publish" Condition="Exists('$(RustReleaseDir)/$(RustLibraryName)')">
        <Copy SourceFiles="$(RustReleaseDir)/$(RustLibraryName)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- The vendored 7z.dll is newer than the one SevenZipExtractor brings, and both are copied to
         the same place; this runs after the package's copy so ours is the one that stays. Native/7z
         /update.ps1 refreshes the pair. -->
    <Target Name="CopyBundled7Zip" AfterTargets="CopyFilesToOutputDirectory">
        <Copy SourceFiles="Native\7z\x64\7z.dll" DestinationFolder="$(OutDir)x64" />
        <Copy SourceFiles="Native\7z\x86\7z.dll" DestinationFolder="$(OutDir)x86" />
    </Target>

    <!-- Publish carries the same native library, or the extra archive formats cannot be opened. -->
    <Target Name="CopySevenZipOnPublish" AfterTargets="Publish">
        <Copy SourceFiles="Native\7z\x64\7z.dll" DestinationFolder="$(PublishDir)x64" />
        <Copy SourceFiles="Native\7z\x86\7z.dll" DestinationFolder="$(PublishDir)x86" />
    </Target>

    <Target Name="CopyRustShellMenuOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and Exists('$(RustReleaseDir)/yafm-shellmenu.exe')">
        <Copy SourceFiles="$(RustReleaseDir)/yafm-shellmenu.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
