<Project Sdk="Microsoft.NET.Sdk">

    <!-- Windows-only sources are compiled only on a Windows host, which is also the only host
         where the Windows SDK projection is referenced; Linux builds leave them out. -->
    <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win')))">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generator -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <!-- The Windows share sheet returns the window's data transfer manager as a COM
             interface; the trimmed single-file build turns built-in COM off by default. -->
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <RootNamespace>YetAnotherFileManager</RootNamespace>
        <Version>0.51.4</Version>
        <!-- A reference's XML file is IntelliSense text the running app never reads. The Windows
             SDK projection's is 13 MB, larger than anything else we ship, so it stays out. -->
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
        <!-- Explorer/taskbar icon; also embedded (Resources\**) so the tray can load it at runtime. -->
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Suppress trim warnings from third-party libraries -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The toast types live in the Windows projection; it ships beside the app without
             changing the target framework, as the shared library's README describes. -->
        <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.28000.87]" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win')))" />
        <Reference Include="Microsoft.Windows.SDK.NET" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win')))">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.28000.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="WinRT.Runtime" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win')))">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.28000.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <!-- The gallery decodes and re-encodes pictures in this process. Garbage that the runtime
             would normally leave lying around is a lot of memory for a file manager, so the GC is
             told to be eager about giving it back instead of waiting for the next collection. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <!-- PhotinoNETUtils creates the startup shortcut with this library. -->
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" />
        <PackageReference Include="Tomlyn" Version="2.11.1" />
        <PackageReference Include="Docnet.Core" Version="2.6.0" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SevenZipExtractor" Version="1.0.19" />
        <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
        <PackageReference Include="SharpCompress" Version="0.50.11"/>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
        <!-- Enumerates the installed font families for the settings page (Windows only). -->
        <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Analyzer Include="Libs\PhotinoNETUtils.Generators.dll" />
        <AdditionalFiles Include="Resources\i18n\*.jsonc" />
    </ItemGroup>

    <PropertyGroup>
        <!-- One executable per platform under Libs/CodeGen/<rid>; the host RID picks the right one.
             Framework-dependent single-file: a Windows machine can cross-publish the Linux build. -->
        <SettingsCodeGenPath>$(MSBuildProjectDirectory)\Libs\CodeGen\$(NETCoreSdkRuntimeIdentifier)\PhotinoNETUtils.CodeGen</SettingsCodeGenPath>
        <SettingsCodeGenPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(SettingsCodeGenPath).exe</SettingsCodeGenPath>
        <SettingsTypeScriptPath>$(MSBuildProjectDirectory)\UserInterface\src\api\settings.generated.ts</SettingsTypeScriptPath>
        <SettingsSchemaPath>$(MSBuildProjectDirectory)\UserInterface\src\api\settings.schema.json</SettingsSchemaPath>
        <LocalizationKeysPath>$(MSBuildProjectDirectory)\UserInterface\src\api\i18n.generated.ts</LocalizationKeysPath>
        <TranslationFile>$(MSBuildProjectDirectory)\Resources\i18n\en.jsonc</TranslationFile>
    </PropertyGroup>

    <!-- The translation keys are not a build product; the file is read directly. -->
    <Target Name="GenerateLocalizationKeys"
            BeforeTargets="BeforeBuild"
            Condition="Exists('$(SettingsCodeGenPath)')"
            Inputs="$(TranslationFile);$(SettingsCodeGenPath)"
            Outputs="$(LocalizationKeysPath)">
        <Exec Command="&quot;$(SettingsCodeGenPath)&quot; --i18n &quot;$(TranslationFile)&quot; --i18n-out &quot;$(LocalizationKeysPath)&quot;"/>
    </Target>

    <!-- The settings come from the compiled model: the compiler has already resolved #if, partial
         files, const references and nameof, so the interface cannot disagree with the app. -->
    <Target Name="GenerateSettingsTypes"
            AfterTargets="CoreCompile"
            Condition="Exists('$(SettingsCodeGenPath)')"
            Inputs="@(IntermediateAssembly);$(SettingsCodeGenPath)"
            Outputs="$(SettingsTypeScriptPath);$(SettingsSchemaPath)">
        <Exec Command="&quot;$(SettingsCodeGenPath)&quot; --assembly &quot;@(IntermediateAssembly)&quot; --out &quot;$(SettingsTypeScriptPath)&quot; --schema &quot;$(SettingsSchemaPath)&quot;"/>
    </Target>

    <ItemGroup>
        <Reference Include="PhotinoNETUtils">
            <HintPath>Libs\PhotinoNETUtils.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
        <!-- The translation files feed the localization key generator and its analyzer: a key a
             Localization.Get call names must exist in them, and a key may be declared once. -->
        <AdditionalFiles Include="Resources\i18n\*.jsonc" />
    </ItemGroup>

    <ItemGroup>
        <!-- The "yafm" command: a batch shim beside the executable, copied to the publish folder
             too so the MSI and the plain archive both carry it. -->
        <None Include="..\installer\windows\yafm.cmd" Link="yafm.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- 7z.dll is redistributed under the LGPL, so its license ships beside it. -->
        <None Include="Native\licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Rust handles bulk filesystem work: the gallery scan, ZIP creation, measuring and deleting
         trees. The library is required, so the build stops when cargo is missing or the crate does
         not compile, and the file is copied beside the executable. -->
    <PropertyGroup>
        <RustManifest>$(MSBuildProjectDirectory)/Native/yafm-native/Cargo.toml</RustManifest>
        <RustReleaseDir>$(MSBuildProjectDirectory)/Native/yafm-native/target/release</RustReleaseDir>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">yafm_native.dll</RustLibraryName>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libyafm_native.so</RustLibraryName>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libyafm_native.dylib</RustLibraryName>

        <!-- The cargo rustup keeps in CARGO_HOME is the one that follows toolchain updates, so it
             is preferred over whatever the launching process happens to have on its PATH. An IDE
             started before rustup was installed has neither, and can set CargoCommand by hand
             (dotnet build -p:CargoCommand=...). -->
        <CargoCommand Condition="'$(CargoCommand)' == '' and '$(CARGO_HOME)' != '' and Exists('$(CARGO_HOME)\bin\cargo.exe')">$(CARGO_HOME)\bin\cargo.exe</CargoCommand>
        <CargoCommand Condition="'$(CargoCommand)' == '' and '$(CARGO_HOME)' != '' and Exists('$(CARGO_HOME)/bin/cargo')">$(CARGO_HOME)/bin/cargo</CargoCommand>
        <CargoCommand Condition="'$(CargoCommand)' == ''">cargo</CargoCommand>
    </PropertyGroup>

    <!-- A machine without a linker cannot run cargo; scripts/build-native.ps1 builds the DLL with the
         MSVC and SDK it finds, and SkipNativeBuild then keeps this target out of the way. -->
    <Target Name="BuildRustNative" BeforeTargets="Build" Condition="Exists('$(RustManifest)') and '$(SkipNativeBuild)' != 'true'">
        <Exec Command="&quot;$(CargoCommand)&quot; build --release --manifest-path &quot;$(RustManifest)&quot;" />
    </Target>

    <Target Name="CopyRustNative" AfterTargets="Build" Condition="Exists('$(RustReleaseDir)/$(RustLibraryName)')">
        <Copy SourceFiles="$(RustReleaseDir)/$(RustLibraryName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustShellMenu" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and Exists('$(RustReleaseDir)/yafm-shellmenu.exe')">
        <Copy SourceFiles="$(RustReleaseDir)/yafm-shellmenu.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustNativeOnPublish" AfterTargets="Publish" Condition="Exists('$(RustReleaseDir)/$(RustLibraryName)')">
        <Copy SourceFiles="$(RustReleaseDir)/$(RustLibraryName)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- The vendored 7z.dll is newer than the one SevenZipExtractor brings, and both are copied to
         the same place; this runs after the package's copy so ours is the one that stays. Only the
         64-bit library ships: every Windows build here is win-x64, so the x86 copy the app picks by
         process bitness would never be loaded. Native/7z/update.ps1 refreshes the pair. -->
    <Target Name="CopyBundled7Zip" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(OS)' == 'Windows_NT'">
        <Copy SourceFiles="Native\7z\x64\7z.dll" DestinationFolder="$(OutDir)x64" />
    </Target>

    <!-- Publish carries the same native library, or the extra archive formats cannot be opened. The
         condition follows the target runtime, so publishing linux-x64 from Windows stays clean. -->
    <Target Name="CopySevenZipOnPublish" AfterTargets="Publish" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
        <Copy SourceFiles="Native\7z\x64\7z.dll" DestinationFolder="$(PublishDir)x64" />
    </Target>

    <!-- Linux has no 7z.dll to load, so it runs the console tool that 7-Zip publishes for it. -->
    <Target Name="CopySevenZipToolOnPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <Copy SourceFiles="Native\7z\linux-x64\7zz" DestinationFolder="$(PublishDir)" />
    </Target>

    <Target Name="CopyRustShellMenuOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and Exists('$(RustReleaseDir)/yafm-shellmenu.exe')">
        <Copy SourceFiles="$(RustReleaseDir)/yafm-shellmenu.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
