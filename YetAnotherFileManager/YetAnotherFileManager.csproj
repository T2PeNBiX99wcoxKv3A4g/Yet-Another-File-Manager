<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generator -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RootNamespace>YetAnotherFileManager</RootNamespace>
        <Version>0.1.1</Version>
        <!-- Explorer/taskbar icon; also embedded (Resources\**) so the tray can load it at runtime. -->
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Suppress trim warnings from third-party libraries -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The gallery decodes and re-encodes pictures in this process. Garbage that the runtime
             would normally leave lying around is a lot of memory for a file manager, so the GC is
             told to be eager about giving it back instead of waiting for the next collection. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
        <PackageReference Include="Docnet.Core" Version="2.6.0" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="PhotinoNETUtils">
            <HintPath>Libs\PhotinoNETUtils.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- The "yafm" command: a batch shim beside the executable, copied to the publish folder
             too so the MSI and the plain archive both carry it. -->
        <None Include="..\installer\windows\yafm.cmd" Link="yafm.cmd"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Rust handles bulk filesystem work: the gallery scan, ZIP creation, measuring and deleting
         trees. The library is required, so the build stops when cargo is missing or the crate does
         not compile, and the file is copied beside the executable. -->
    <PropertyGroup>
        <RustManifest>$(MSBuildProjectDirectory)/Native/yafm-native/Cargo.toml</RustManifest>
        <RustReleaseDir>$(MSBuildProjectDirectory)/Native/yafm-native/target/release</RustReleaseDir>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">yafm_native.dll</RustLibraryName>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libyafm_native.so</RustLibraryName>
        <RustLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libyafm_native.dylib</RustLibraryName>

        <!-- The cargo rustup keeps in CARGO_HOME is the one that follows toolchain updates, so it
             is preferred over whatever the launching process happens to have on its PATH. An IDE
             started before rustup was installed has neither, and can set CargoCommand by hand
             (dotnet build -p:CargoCommand=...). -->
        <CargoCommand Condition="'$(CargoCommand)' == '' and '$(CARGO_HOME)' != '' and Exists('$(CARGO_HOME)\bin\cargo.exe')">$(CARGO_HOME)\bin\cargo.exe</CargoCommand>
        <CargoCommand Condition="'$(CargoCommand)' == '' and '$(CARGO_HOME)' != '' and Exists('$(CARGO_HOME)/bin/cargo')">$(CARGO_HOME)/bin/cargo</CargoCommand>
        <CargoCommand Condition="'$(CargoCommand)' == ''">cargo</CargoCommand>
    </PropertyGroup>

    <Target Name="BuildRustNative" BeforeTargets="Build" Condition="Exists('$(RustManifest)')">
        <Exec Command="&quot;$(CargoCommand)&quot; build --release --manifest-path &quot;$(RustManifest)&quot;" />
    </Target>

    <Target Name="CopyRustNative" AfterTargets="Build"
            Condition="Exists('$(RustReleaseDir)/$(RustLibraryName)')">
        <Copy SourceFiles="$(RustReleaseDir)/$(RustLibraryName)" DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustNativeOnPublish" AfterTargets="Publish"
            Condition="Exists('$(RustReleaseDir)/$(RustLibraryName)')">
        <Copy SourceFiles="$(RustReleaseDir)/$(RustLibraryName)" DestinationFolder="$(PublishDir)"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
